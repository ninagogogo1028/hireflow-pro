# Template for .env.local. Copy to .env.local and fill in.
# This file is committed, so it must contain placeholders only.
#
# Only VITE_-prefixed variables reach client code, and Vite bakes them into the
# bundle, so everything here is PUBLIC. Never add a provider API key: a browser
# app has nowhere to hide one. The Gemini credential lives only in Supabase Edge
# Function secrets, set through the Supabase dashboard.

# URL of the ai-proxy Edge Function.
# Found under: Supabase dashboard -> Edge Functions -> ai-proxy.
VITE_AI_PROXY_URL=https://<your-project-ref>.supabase.co/functions/v1/ai-proxy

# Supabase publishable (anon) key. Public by design: it satisfies the gateway's
# key check and grants no privileges beyond invoking the function.
# Found under: Supabase dashboard -> Project Settings -> API Keys.
# Do NOT use the service_role / secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
